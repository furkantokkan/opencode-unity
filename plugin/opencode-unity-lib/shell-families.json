{
  "schemaVersion": 1,
  "common": {
    "unmodelled": [
      { "pattern": "[*?]", "what": "a wildcard" },
      { "pattern": "[\\[\\]]", "what": "a bracket expression" },
      { "pattern": "~", "what": "a home directory expansion" },
      { "pattern": "%", "what": "an expansion or job reference" },
      { "pattern": "`", "what": "a backtick" },
      { "pattern": "!", "what": "an expansion or negation operator" },
      { "pattern": "\\$", "what": "a variable expansion" },
      { "pattern": "[{}]", "what": "a brace expression" },
      { "pattern": "\\^", "what": "an escape character" },
      { "pattern": "::", "what": "a label or member operator" },
      { "pattern": "<<|<>|[<>]&|&>|>\\||\\|&", "what": "a heredoc or descriptor redirection" },
      { "pattern": "[\\r\\v\\f\\x00-\\x08\\x0e-\\x1f]", "what": "a control character" }
    ],
    "unmodelledArguments": [
      { "pattern": "(?:^|:)(?:alias|function|env|variable):", "flags": "i", "what": "a PowerShell alias, function, environment or variable drive path, which changes what a later name runs" }
    ]
  },
  "unmodelledCommandsNote": "First words that are not programs: shell reserved words and compound-statement keywords, whose body is a command the node reader never sees as a first word (if git push; then :; fi), and constructs that define a new name for a program or run a command later (alias, Set-Alias, hash -p, trap, sched, emulate -c, cmd's call). Every family refuses all of them, because the family itself can be wrong. The second block (S36) is the alias rule: the agent shell runs without the user's aliases, so the constructs that would re-enable, define or rebind a name from inside the command are refused too - shell options (shopt, setopt, set, enable), variables that decide what a later word resolves to (export, declare, typeset, PATH through set or setx, PowerShell's Set-Variable) and loaders that bring in definitions (autoload, zmodload, Import-Module, Add-Type, New-Object). The third block is PowerShell statements that yield no command node at all.",
  "unmodelledCommands": [
    "if", "then", "else", "elif", "elseif", "fi", "do", "done", "while", "until", "for", "foreach", "in",
    "case", "esac", "select", "switch", "function", "filter", "workflow", "repeat", "begin", "end",
    "and", "or", "not", "try", "catch", "finally", "trap",
    "alias", "unalias", "hash", "fc", "sched", "emulate",
    "set-alias", "sal", "new-alias", "nal", "import-alias", "ipal",
    "call", "doskey",
    "export", "declare", "typeset", "local", "readonly", "integer", "float", "set", "unset",
    "shopt", "setopt", "unsetopt", "enable", "disable", "autoload", "zmodload", "functions", "unfunction",
    "setenv", "unsetenv", "setx", "path", "assoc", "ftype",
    "set-variable", "sv", "new-variable", "nv", "clear-variable", "clv", "remove-variable", "rv",
    "import-module", "ipmo", "new-module", "nmo", "add-type", "new-object", "set-executionpolicy", "set-psdebug",
    "using", "param", "class", "enum", "data", "dynamicparam", "configuration", "throw", "return", "exit", "break", "continue"
  ],
