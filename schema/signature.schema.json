{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opencode-unity component signature file",
  "description": "One signature file in src/project/signatures/. Component detection is data (D-B16): every row names what it establishes, how it is recognised, and the verified source it came from. Only verified names ship (D-B17): a row without an evidence file, a version and a retrieval date fails the signatures lint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "rows"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "description": "Namespace for every row id in this file.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,23}$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fact", "match", "claim", "evidence", "version", "retrieved"],
      "properties": {
        "id": {
          "description": "`<file id>/<fact>.<name>`; stable, because evidence rows and doctor --explain quote it.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,23}/[a-z][a-z0-9-]{0,23}\\.[a-z0-9][a-z0-9.-]{0,39}$"
        },
        "fact": {
          "description": "What a match establishes.",
          "enum": ["anchor", "overlay", "workspace-marker", "package-manager", "test-runner", "framework", "runtime", "migrations", "signal", "port", "never-opened"]
        },
        "value": {
          "description": "The value the fact takes when the row matches, for example `npm` or `node-service`.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "match": { "$ref": "#/$defs/match" },
        "note": { "type": "string", "maxLength": 240 },
        "claim": {
          "description": "Claim id in the amendment's backend claims table.",
          "type": "string",
          "pattern": "^B[0-9]{1,3}$"
        },
        "evidence": {
          "description": "Evidence file name under the design's verify/backend/ directory.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,99}$"
        },
        "version": {
          "description": "The source's version or branch on the retrieval date; never a version this row matches on.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "retrieved": {
          "description": "ISO date the evidence was fetched.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "match": {
      "description": "How the row is recognised. Every key is a literal comparison; there is no regular expression and no scoring, so a match is always explainable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fileName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "fileNames": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "extension": { "type": "string", "pattern": "^\\.[a-z0-9]{1,12}$" },
        "dirName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 128 },
        "inDirNamed": { "type": "string", "minLength": 1, "maxLength": 64 },
        "contains": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "dependency": { "type": "string", "minLength": 1, "maxLength": 64 },
        "unityPackage": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
        "assembly": { "type": "string", "minLength": 1, "maxLength": 64 },
        "jsonKey": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  }
}
