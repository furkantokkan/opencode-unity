[
  {
    "id": "jwt-hs256",
    "patternId": "cred.jwt",
    "sample": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJleGFtcGxlIn0.QUJDREVGR0hJSktMTU5PUFFSU1RVVldY",
    "note": "three base64url segments, the first starting eyJ"
  },
  {
    "id": "jwt-unsigned",
    "patternId": "cred.jwt",
    "sample": "eyJhbGciOiJub25lIn0.eyJzdWIiOiJleGFtcGxlIn0.",
    "note": "alg none is still a token, so the signature segment may be empty"
  },
  {
    "id": "google-api-key",
    "patternId": "cred.google-api-key",
    "sample": "AIzaSyExampleNotARealKey00000000000000A",
    "note": "AIza and 35 URL-safe characters"
  },
  {
    "id": "google-api-key-in-query",
    "patternId": "cred.google-api-key",
    "sample": "https://example.test/v1/models?q=AIzaSyExampleNotARealKey00000000000000A",
    "note": "the same shape reached through a query value the model chose"
  },
  {
    "id": "google-oauth",
    "patternId": "cred.google-oauth",
    "sample": "ya29.ExampleAccessTokenValueNotReal",
    "note": "ya29. and 20 or more characters"
  },
  {
    "id": "firebase-refresh",
    "patternId": "cred.firebase-refresh",
    "sample": "refreshToken 1//0gExampleRefreshTokenNotReal",
    "note": "the shape firebase login:ci prints, which must be treated like a password"
  },
  {
    "id": "pem-rsa",
    "patternId": "cred.pem-block",
    "sample": "-----BEGIN RSA PRIVATE KEY-----",
    "note": "the header alone is the hit; the key material below it is never looked at"
  },
  {
    "id": "pem-plain",
    "patternId": "cred.pem-block",
    "sample": "-----BEGIN PRIVATE KEY-----",
    "note": "no algorithm word between BEGIN and PRIVATE KEY"
  },
  {
    "id": "aws-access-key",
    "patternId": "cred.aws-access-key",
    "sample": "AKIAIOSFODNN7EXAMPLE",
    "note": "the access key id the AWS documentation itself uses as its example"
  },
  {
    "id": "aws-temporary-key",
    "patternId": "cred.aws-access-key",
    "sample": "ASIAY34FZKBOKMUTVV7A",
    "note": "a temporary session key id"
  },
  {
    "id": "github-token",
    "patternId": "cred.github-token",
    "sample": "ghp_EXAMPLEnotAREALtokenVALUE00000000000",
    "note": "gh[pousr]_ and 36 or more characters"
  },
  {
    "id": "github-refresh-token",
    "patternId": "cred.github-token",
    "sample": "ghr_EXAMPLEnotAREALtokenVALUE00000000000",
    "note": "the refresh flavour of the same prefix set"
  },
  {
    "id": "slack-bot-token",
    "patternId": "cred.slack-token",
    "sample": "xoxb-0000000000-EXAMPLEnotREAL",
    "note": "xox[baprs]- and 10 or more characters"
  },
  {
    "id": "bearer-header",
    "patternId": "cred.bearer",
    "sample": "Authorization: Bearer EXAMPLEbearerVALUEnotREALat0all",
    "note": "Bearer and 24 or more non-space characters"
  },
  {
    "id": "bearer-lowercase",
    "patternId": "cred.bearer",
    "sample": "authorization: bearer EXAMPLEbearerVALUEnotREALat0all",
    "note": "HTTP folds the scheme name, so the detector does too"
  },
  {
    "id": "high-entropy-token",
    "patternId": "cred.high-entropy",
    "sample": "hT3kQ9zR1mWpX7vL2bN8cF4jY6sD0gA5",
    "note": "32 base64url characters, mixed case at random, above 3.5 bits per character"
  },
  {
    "id": "assignment-query",
    "patternId": "cred.assignment",
    "sample": "https://example.test/v1/session?password=notARealPassword",
    "note": "a query parameter whose key is in the sensitive-key set"
  },
  {
    "id": "assignment-json",
    "patternId": "cred.assignment",
    "sample": "{\"client_secret\": \"notARealClientSecret\"}",
    "note": "the JSON spelling of the same rule"
  },
  {
    "id": "assignment-env-line",
    "patternId": "cred.assignment",
    "sample": "PROJECT_NAME=demo-app\nACCESS_TOKEN=notARealAccessToken",
    "note": "an environment line pasted into a body; only the second line has a sensitive key"
  },
  {
    "id": "assignment-folded-key",
    "patternId": "cred.assignment",
    "sample": "?api-Key=notARealApiKeyValue",
    "note": "separators and case fold, so api-Key is apikey"
  }
]
