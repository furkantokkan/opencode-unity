// Rendered by opencode-unity 0.1.0 into <home>/profile/<cliVersion>/opencode.jsonc.
// Edits are lost: `opencode-unity upgrade` rewrites this file. Change config.json instead.
// There is no "provider" block on purpose; the plugin injects it, so a broken plugin fails closed.
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "lsp": false,
  "enabled_providers": ["opencode-unity"],
  "model": "opencode-unity/ocu-qwen3-coder-30b-16k",
  "small_model": "opencode-unity/ocu-qwen3-coder-30b-16k",
  "default_agent": "unity-code",
  "compaction": { "auto": true, "prune": true },
  "tool_output": { "max_lines": 250, "max_bytes": 12000 },
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "title": { "disable": true }
  },
  "permission": {
    "*_*": "deny",
    "task": "deny",
    "todowrite": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "codesearch": "deny",
    "skill": "deny",
    "question": "deny",
    "doom_loop": "deny",
    "external_directory": {
      "*": "deny"
    },
    "bash": {
      "*": "deny"
    },
    "read": {
      "*.unity": "deny",
      "*.prefab": "deny",
      "*Library/*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p8": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.keystore": "deny",
      "*.jks": "deny",
      "*.mobileprovision": "deny",
      "*.ppk": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*credentials*": "deny",
      "*service-account*.json": "deny",
      "*service_account*.json": "deny",
      "*google-services*.json": "deny",
      "*GoogleService-Info*.plist": "deny",
      "*.npmrc": "deny",
      "*.netrc": "deny",
      "*.git-credentials": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*.unity": "deny",
      "*.prefab": "deny",
      "*.asset": "deny",
      "*.meta": "deny",
      "*.mat": "deny",
      "*.controller": "deny",
      "*.overrideController": "deny",
      "*.anim": "deny",
      "*.mask": "deny",
      "*.mixer": "deny",
      "*.playable": "deny",
      "*.signal": "deny",
      "*.spriteatlas": "deny",
      "*.spriteatlasv2": "deny",
      "*.terrainlayer": "deny",
      "*.lighting": "deny",
      "*.renderTexture": "deny",
      "*.physicMaterial": "deny",
      "*.physicsMaterial2D": "deny",
      "*.shadergraph": "deny",
      "*.shadersubgraph": "deny",
      "*.vfx": "deny",
      "*.inputactions": "deny",
      "*.asmdef": "deny",
      "*.asmref": "deny",
      "*.csproj": "deny",
      "*.sln": "deny",
      "*.slnx": "deny",
      "*ProjectSettings/*": "deny",
      "*Packages/manifest.json": "deny",
      "*Packages/packages-lock.json": "deny",
      "*Library/*": "deny",
      "*Temp/*": "deny",
      "*Logs/*": "deny",
      "*UserSettings/*": "deny",
      "*obj/*": "deny",
      "*.opencode-unity/*": "deny"
    }
  }
}
